<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Hemraj | Data Analyst</title>

<style>
html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: #f8fafc;
    color: #1e293b;
}

/* NAVBAR */
nav {
    position: sticky;
    top: 0;
    background: white;
    padding: 10px;
    text-align: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    z-index: 10;
}

nav a {
    margin: 0 15px;
    text-decoration: none;
    color: #0ea5e9;
    font-weight: bold;
}

/* HEADER */
header {
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, #e0f2fe, #f8fafc);
}

header img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 3px solid #0ea5e9;
    object-fit: cover;
}

.subtitle {
    color: #475569;
}

/* SECTION */
section {
    max-width: 1000px;
    margin: auto;
    padding: 30px 20px;
}

h2 {
    border-left: 4px solid #0ea5e9;
    padding-left: 10px;
}

/* GRID */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
}

/* CARD */
.card {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

/* SKILLS */
.skill {
    margin: 20px 0;
}

.bar {
    height: 10px;
    background: #e2e8f0;
    border-radius: 10px;
    margin-top: 8px;
}

.fill {
    height: 100%;
    background: #0ea5e9;
    border-radius: 10px;
}

/* TAGS */
.tags span {
    display: inline-block;
    background: #e0f2fe;
    padding: 8px 12px;
    margin: 5px;
    border-radius: 20px;
}

/* BUTTON */
.button {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 20px;
    background: #0ea5e9;
    color: white;
    border-radius: 20px;
    text-decoration: none;
}

/* CONTACT */
.contact-box {
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

/* FOOTER */
footer {
    text-align: center;
    padding: 20px;
    background: #e2e8f0;
}
</style>

</head>

