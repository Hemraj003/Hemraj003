<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hemraj.R — Data Analyst</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F1F3F6;
    --panel:#FFFFFF;
    --line:#D8DCE3;
    --ink:#1B2430;
    --ink-soft:#5B6472;
    --amber:#E3A008;
    --teal:#1F8A70;
    --coral:#E0563F;
    --radius:2px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;text-decoration:none;}

  a:focus-visible, button:focus-visible, input:focus-visible{
    outline:2px solid var(--teal);
    outline-offset:2px;
  }

  .topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:14px clamp(20px,5vw,56px);
    border-bottom:1px solid var(--line);
    background:var(--panel);
    position:sticky;
    top:0;
    z-index:10;
  }
  .topbar .logo{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:15px;
    letter-spacing:0.02em;
  }
  .topbar .logo span{color:var(--amber);}
  .topbar nav{display:flex;gap:28px;}
  .topbar nav a{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--ink-soft);
    text-transform:uppercase;
    letter-spacing:0.08em;
  }
  .topbar nav a:hover{color:var(--ink);}

  section{
    max-width:1080px;
    margin:0 auto;
    padding:64px clamp(20px,5vw,56px);
  }

  .hero{
    padding-top:72px;
    padding-bottom:56px;
  }
  .hero-eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--teal);
    text-transform:uppercase;
    letter-spacing:0.12em;
    display:flex;
    align-items:center;
    gap:8px;
    margin-bottom:18px;
  }
  .hero-eyebrow::before{
    content:"";
    width:8px;height:8px;
    background:var(--teal);
    border-radius:50%;
    display:inline-block;
  }
  h1{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:clamp(40px,7vw,72px);
    letter-spacing:-0.01em;
    line-height:1.02;
  }
  .hero-role{
    font-family:'Space Grotesk',sans-serif;
    font-size:clamp(18px,2.4vw,24px);
    color:var(--ink-soft);
    margin-top:10px;
    font-weight:500;
  }
  .hero-role .pipe{color:var(--line);margin:0 8px;}
  .hero-summary{
    max-width:620px;
    margin-top:24px;
    color:var(--ink-soft);
    font-size:16px;
  }
  .hero-cta{
    display:flex;
    gap:14px;
    margin-top:32px;
    flex-wrap:wrap;
  }
  .btn{
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;
    padding:12px 20px;
    border:1px solid var(--ink);
    border-radius:var(--radius);
    display:inline-flex;
    align-items:center;
    gap:8px;
    transition:all .15s ease;
  }
  .btn-solid{background:var(--ink);color:#fff;}
  .btn-solid:hover{background:var(--teal);border-color:var(--teal);}
  .btn-outline:hover{background:var(--ink);color:#fff;}

  .cell-label{
    display:inline-flex;
    align-items:center;
    gap:10px;
    margin-bottom:28px;
  }
  .cell-ref{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--panel);
    background:var(--ink);
    padding:3px 8px;
    border-radius:var(--radius);
  }
  .cell-title{
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:22px;
  }

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:var(--radius);
  }
  .skills-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:0;
  }
  .skill-row{
    padding:18px 24px;
    border-bottom:1px solid var(--line);
    border-right:1px solid var(--line);
  }
  .skill-row:nth-child(odd){border-right:1px solid var(--line);}
  .skill-row:nth-child(even){border-right:none;}
  @media (max-width:640px){
    .skills-grid{grid-template-columns:1fr;}
    .skill-row{border-right:none;}
  }
  .skill-top{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    margin-bottom:10px;
  }
  .skill-name{font-weight:600;font-size:14px;}
  .skill-pct{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--ink-soft);}
  .bar-track{
    height:8px;
    background:var(--bg);
    border-radius:2px;
    overflow:hidden;
  }
  .bar-fill{
    height:100%;
    background:var(--amber);
    border-radius:2px;
  }
  .skill-row:nth-child(4n+1) .bar-fill, .skill-row:nth-child(4n+2) .bar-fill{background:var(--teal);}
  .skill-desc{
    font-size:12px;
    color:var(--ink-soft);
    margin-top:8px;
  }

  .strengths{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top:36px;
  }
  .chip{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    padding:8px 14px;
    border:1px solid var(--line);
    border-radius:20px;
    background:var(--panel);
  }

  .project-card{
    padding:32px;
    display:grid;
    grid-template-columns:200px 1fr;
    gap:32px;
  }
  @media (max-width:700px){.project-card{grid-template-columns:1fr;}}
  .project-meta{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--ink-soft);
  }
  .project-meta .tag{
    display:block;
    margin-top:14px;
    color:var(--ink);
    font-weight:600;
  }
  .project-title{
    font-family:'Space Grotesk',sans-serif;
    font-size:24px;
    font-weight:600;
    margin-bottom:16px;
  }
  .project-list{list-style:none;}
  .project-list li{
    position:relative;
    padding-left:20px;
    margin-bottom:10px;
    font-size:14.5px;
    color:var(--ink-soft);
  }
  .project-list li::before{
    content:"▸";
    position:absolute;
    left:0;
    color:var(--amber);
  }

  .edu-item{
    display:grid;
    grid-template-columns:120px 1fr;
    gap:24px;
    padding:22px 0;
    border-bottom:1px solid var(--line);
  }
  .edu-item:last-child{border-bottom:none;}
  .edu-date{
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;
    color:var(--teal);
  }
  .edu-school{font-weight:600;font-size:15px;}
  .edu-degree{font-size:13.5px;color:var(--ink-soft);margin-top:4px;}
  .edu-score{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--ink-soft);
    margin-top:6px;
  }

  .contact-panel{
    padding:40px;
  }
  .contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:24px;
    margin-top:28px;
  }
  @media (max-width:640px){.contact-grid{grid-template-columns:1fr;}}
  .field-label{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--ink-soft);
    margin-bottom:8px;
    display:block;
  }
  .field-row{
    display:flex;
    gap:8px;
  }
  input[type="text"]{
    flex:1;
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;
    padding:11px 12px;
    border:1px solid var(--line);
    border-radius:var(--radius);
    background:var(--bg);
    color:var(--ink);
  }
  .link-out{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    padding:11px 14px;
    border:1px solid var(--ink);
    border-radius:var(--radius);
    white-space:nowrap;
    display:inline-flex;
    align-items:center;
    background:var(--ink);
    color:#fff;
    transition:background .15s ease;
  }
  .link-out:hover{background:var(--teal);}
  .link-out.disabled{
    background:var(--panel);
    color:var(--ink-soft);
    border-color:var(--line);
    pointer-events:none;
  }
  .hint{
    font-size:12px;
    color:var(--ink-soft);
    margin-top:6px;
  }
  .static-contacts{
    display:flex;
    gap:28px;
    margin-top:32px;
    flex-wrap:wrap;
    padding-top:24px;
    border-top:1px solid var(--line);
  }
  .static-contacts a, .static-contacts span{
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;
    color:var(--ink-soft);
  }

  footer{
    text-align:center;
    padding:32px;
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    color:var(--ink-soft);
    border-top:1px solid var(--line);
  }
</style>
</head>
<body>

<div class="topbar">
  <div class="logo">HEMRAJ<span>.R</span></div>
  <nav>
    <a href="#skills">Skills</a>
    <a href="#project">Project</a>
    <a href="#education">Education</a>
    <a href="#contact">Contact</a>
  </nav>
</div>

<section class="hero">
  <div class="hero-eyebrow">Available for opportunities</div>
  <h1>Hemraj.R</h1>
  <div class="hero-role">Data Analyst <span class="pipe">/</span> Python <span class="pipe">/</span> SQL <span class="pipe">/</span> Power BI</div>
  <p class="hero-summary">Motivated and detail-oriented aspiring data analyst who turns raw datasets into
    clear, decision-ready insight — cleaning, querying, and visualizing data with Python, SQL, and Power BI.</p>
  <div class="hero-cta">
    <a href="#project" class="btn btn-solid">View project</a>
    <a href="#contact" class="btn btn-outline">Get in touch</a>
  </div>
</section>

<section id="skills">
  <div class="cell-label">
    <span class="cell-ref">A1</span>
    <span class="cell-title">Skills</span>
  </div>
  <div class="panel skills-grid">
    <div class="skill-row">
      <div class="skill-top"><span class="skill-name">Python</span><span class="skill-pct mono">Pandas · NumPy · Matplotlib</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:82%"></div></div>
    </div>
    <div class="skill-row">
      <div class="skill-top"><span class="skill-name">SQL</span><span class="skill-pct mono">Querying · Joins · Aggregation</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:78%"></div></div>
    </div>
    <div class="skill-row">
      <div class="skill-top"><span class="skill-name">Power BI</span><span class="skill-pct mono">Dashboards · Reporting</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:80%"></div></div>
    </div>
    <div class="skill-row">
      <div class="skill-top"><span class="skill-name">Data Cleaning &amp; Analysis</span><span class="skill-pct mono">ETL basics</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:75%"></div></div>
    </div>
    <div class="skill-row">
      <div class="skill-top"><span class="skill-name">Data Visualization</span><span class="skill-pct mono">Charts &amp; storytelling</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:77%"></div></div>
    </div>
    <div class="skill-row">
      <div class="skill-top"><span class="skill-name">Statistical Analysis</span><span class="skill-pct mono">Foundations</span></div>
      <div class="bar-track"><div class="bar-fill" style="width:65%"></div></div>
    </div>
  </div>

  <div class="strengths">
    <span class="chip">Analytical Thinking</span>
    <span class="chip">Problem Solving</span>
    <span class="chip">Quick Learning</span>
    <span class="chip">Attention to Detail</span>
    <span class="chip">Data-Driven Decision Making</span>
  </div>
</section>

<section id="project">
  <div class="cell-label">
    <span class="cell-ref">B1</span>
    <span class="cell-title">Project</span>
  </div>
  <div class="panel project-card">
    <div class="project-meta">
      Type
      <span class="tag">Personal project</span>
      Stack
      <span class="tag">Python · SQL · Power BI</span>
    </div>
    <div>
      <div class="project-title">Sales Data Analysis Dashboard</div>
      <ul class="project-list">
        <li>Analyzed sales data using Python and Pandas.</li>
        <li>Cleaned and transformed raw datasets to prepare them for analysis.</li>
        <li>Created charts to understand sales trends and outlet performance.</li>
        <li>Built interactive dashboards in Power BI for at-a-glance reporting.</li>
        <li>Used SQL to retrieve and analyze business data.</li>
        <li>Identified key sales patterns and insights from the dataset.</li>
      </ul>
    </div>
  </div>
</section>

<section id="education">
  <div class="cell-label">
    <span class="cell-ref">C1</span>
    <span class="cell-title">Education</span>
  </div>
  <div class="panel" style="padding:8px 32px;">
    <div class="edu-item">
      <div class="edu-date mono">2021 — 2025</div>
      <div>
        <div class="edu-school">Trichy Engineering College</div>
        <div class="edu-degree">Bachelor of Engineering (B.E.)</div>
        <div class="edu-score">CGPA: 8.0</div>
      </div>
    </div>
    <div class="edu-item">
      <div class="edu-date mono">10th Std</div>
      <div>
        <div class="edu-school">All Saint's High School</div>
        <div class="edu-score">CGPA: 59</div>
      </div>
    </div>
    <div class="edu-item">
      <div class="edu-date mono">12th Std</div>
      <div>
        <div class="edu-school">Government Higher Secondary School</div>
        <div class="edu-score">Score: 70%</div>
      </div>
    </div>
  </div>
</section>

<section id="contact">
  <div class="cell-label">
    <span class="cell-ref">D1</span>
    <span class="cell-title">Contact</span>
  </div>
  <div class="panel contact-panel">
    <p class="hint">Add your GitHub username and LinkedIn profile URL below — the buttons will link out once filled in.</p>
    <div class="contact-grid">
      <div>
        <label class="field-label" for="githubInput">GitHub username</label>
        <div class="field-row">
          <input type="text" id="githubInput" placeholder="e.g. hemrajr" oninput="updateLinks()">
          <a id="githubLink" class="link-out disabled" href="#" target="_blank" rel="noopener">Open ↗</a>
        </div>
      </div>
      <div>
        <label class="field-label" for="linkedinInput">LinkedIn profile URL</label>
        <div class="field-row">
          <input type="text" id="linkedinInput" placeholder="e.g. linkedin.com/in/hemrajr" oninput="updateLinks()">
          <a id="linkedinLink" class="link-out disabled" href="#" target="_blank" rel="noopener">Open ↗</a>
        </div>
      </div>
    </div>

    <div class="static-contacts">
      <a href="tel:7397022321">📞 7397022321</a>
      <a href="mailto:hemrajramesh59@gmail.com">✉ hemrajramesh59@gmail.com</a>
    </div>
  </div>
</section>

<footer>© 2026 Hemraj.R — Built for portfolio use</footer>

<script>
  function updateLinks(){
    const gh = document.getElementById('githubInput').value.trim();
    const li = document.getElementById('linkedinInput').value.trim();
    const ghLink = document.getElementById('githubLink');
    const liLink = document.getElementById('linkedinLink');

    if(gh){
      const ghUrl = gh.startsWith('http') ? gh : 'https://github.com/' + gh.replace(/^@/, '');
      ghLink.href = ghUrl;
      ghLink.classList.remove('disabled');
    } else {
      ghLink.href = '#';
      ghLink.classList.add('disabled');
    }

    if(li){
      const liUrl = li.startsWith('http') ? li : 'https://' + li;
      liLink.href = liUrl;
      liLink.classList.remove('disabled');
    } else {
      liLink.href = '#';
      liLink.classList.add('disabled');
    }
  }
</script>

</body>
</html>
